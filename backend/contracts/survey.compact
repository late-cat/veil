pragma language_version >= 0.23;

import CompactStandardLibrary;

// The public ledger state for VEIL Platform
// Maps a Campaign ID (Bytes<32>) to its participation count.
export ledger campaigns: Map<Bytes<32>, Uint<32>>;

// A set of used nullifiers across the entire platform to prevent double-submission.
// The nullifier will be derived off-chain as hash(campaignId, secret).
export ledger nullifiers: Set<Bytes<32>>;

// The private witness represents the user's secret eligibility string/seed.
witness secretEligibilityHash(): Bytes<32>;

// Struct to securely hash the Campaign ID and Private Witness together
export struct NullifierInput {
    campaignId: Bytes<32>,
    secret: Bytes<32>
}

// The circuit now ONLY accepts the Campaign ID. The nullifier is derived internally.
export circuit submitFeedback(campaignId: Bytes<32>): [] {
    // 1. Verify eligibility
    // In a real product, we would verify a Merkle inclusion proof here.
    const secretHash = secretEligibilityHash();
    
    // We explicitly disclose the campaignId to the public ledger
    const revealedCampaignId = disclose(campaignId);
    
    // 2. Cryptographically derive the nullifier INSIDE the circuit
    const input = NullifierInput { campaignId: campaignId, secret: secretHash };
    const derivedNullifier = persistentHash<NullifierInput>(input);
    const revealedNullifier = disclose(derivedNullifier);
    
    // 2. Prevent duplicate submissions for this specific campaign
    // The nullifier is scoped to the campaign off-chain, but we verify uniqueness globally.
    assert(!nullifiers.member(revealedNullifier), "You have already submitted feedback to this campaign or the nullifier is invalid.");
        
    // 3. Update public state
    // We update the specific campaign's counter.
    nullifiers.insert(revealedNullifier);
    
    if (campaigns.member(revealedCampaignId)) {
        const currentCount = campaigns.lookup(revealedCampaignId);
        campaigns.insert(revealedCampaignId, (currentCount + 1) as Uint<32>);
    } else {
        // If it's the first vote, initialize the counter
        campaigns.insert(revealedCampaignId, 1 as Uint<32>);
    }
}
